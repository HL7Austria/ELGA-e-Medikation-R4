@startuml

title Patient Journey – e-Medikation
'!option handwritten true

skinparam borderColor #000000
skinparam backgroundColor #f5f5f5
skinparam shadowing false
skinparam roundCorner 10
skinparam defaultFontName "Arial"
skinparam defaultFontSize 14
skinparam defaultFontColor #000000

skinparam HyperlinkColor #0000EE
skinparam HyperlinkUnderline false

skinparam BoxPadding 20
skinparam BoxBorderColor #555555

skinparam note {
  BackgroundColor #e0e5f0-#d1d9e6
  BorderColor #8b95a5
  BorderThickness 1
  RoundCorner 0
  Padding 6
  FontColor #111827
  Shadowing false
}

skinparam sequence {
  ParticipantBorderColor #555555
  ParticipantBackgroundColor #ffffff
  ParticipantFontColor #000000
  ParticipantFontSize 14
  ParticipantPadding 20
  ArrowColor #111827
  ArrowThickness 1
  ArrowFontColor #000000
  ArrowFontSize 13
  GroupBorderColor #111827
  GroupBackgroundColor #eef2ff
  GroupBorderThickness 2
}

!define COLOR_GDA_1    #15608280
!define COLOR_GDA_2    #96607D80
!define COLOR_GDA_3    #beaf3c80
!define COLOR_PATIENT  #196B2480
!define COLOR_APO      #0F9ED590
!define COLOR_EMED_FA  #e97232bd
!define COLOR_OK       #0F9ED525
!define COLOR_ERROR    #E9713235

' !define COLOR_GDA_1_BOX    #15608280
' !define COLOR_GDA_2_BOX    #96607D80
' !define COLOR_PATIENT_BOX  #196B2480
' !define COLOR_APO_BOX      #0F9ED590
' !define COLOR_EMED_FA_BOX  #e97232bd

actor Patient as "Max Mustermann" COLOR_PATIENT
actor Arzt_1 as "Dr. Hausärztin" COLOR_GDA_1
actor Arzt_2 as "Dr. Krankenhaus" COLOR_GDA_2
actor Arzt_3 as "Dr. Urlaubsvertretung" COLOR_GDA_3
actor Apotheke as "Amadeus Apotheke" COLOR_APO
participant eMed_FA as "e-Medikation" COLOR_EMED_FA

!define GROUP_ARZT          #96607D30
!define GROUP_APO           #0F9ED530
!define GROUP_KH           #beaf3c30
!define GROUP_PAT           #196B2430


' box "\n Patient " COLOR_PATIENT_BOX
' actor Patient as "Max Mustermann" COLOR_PATIENT
' end box

' box "\n Ärztin " COLOR_GDA_1_BOX
' actor Arzt_1 as "Dr. Hausärztin" COLOR_GDA_1
' end box

' box "\n Krankenhaus " COLOR_GDA_2_BOX
' actor Arzt_2 as "Dr. Krankenhaus" COLOR_GDA_2
' end box

' box "\n Apotheke " COLOR_APO_BOX
' actor Apotheke as "Amadeus Apotheke" COLOR_APO
' end box

' box "\n       e-Med Fachanwendung       " COLOR_EMED_FA
' participant eMed_FA as "e-Medikation" COLOR_EMED_FA
' end box


autonumber

group GROUP_ARZT 27.2.2026 · Arztbesuch

  activate Patient COLOR_PATIENT
  Patient -> Arzt_1: Arztbesuch

  activate Arzt_1 COLOR_GDA_1

  ' == Medikationsplan erstmals abrufen ==

  Arzt_1 -> eMed_FA: aktuellen Medikationsplan,\nGeplante und Durchgeführte\nAbgaben abrufen

  activate eMed_FA COLOR_EMED_FA


  eMed_FA -> Arzt_1: leerer Medikationsplan\n(*EmptyReason = notstarted*)\n(Geplante und Durchgeführte\nAbgaben leeres Ergebnis)

  deactivate eMed_FA
  '  deactivate Patient

  ' == Medikationsplaneinträge hinzufügen ==

  Arzt_1 -> Arzt_1: neue Planeinträge erstellen +\nMedikationsplan bearbeiten

  Arzt_1 -> eMed_FA: neuen Medikationsplan speichern

  activate eMed_FA COLOR_EMED_FA


  Arzt_1 -> Arzt_1: Geplante Abgaben erstellen

  Arzt_1 -> eMed_FA: Geplante Abgaben speichern

  deactivate eMed_FA
  deactivate Arzt_1
  '  deactivate Patient

end

group GROUP_APO 28.2.2026 · Abgabe in der Apotheke (Besorgerprozess)

  '  activate Patient COLOR_PATIENT

  Patient -> Apotheke: Medikamente abholen

  activate Apotheke COLOR_APO

  Apotheke -> eMed_FA: aktuellen Medikationsplan,\nGeplante und Durchgeführte\nAbgaben abrufen

  activate eMed_FA COLOR_EMED_FA
  eMed_FA -> Apotheke: Aktueller Medikationsplan +\nGeplante Abgaben abrufen\n(Durchgeführte Abgaben\nleeres Ergebnis)
  deactivate eMed_FA

  Apotheke -> Apotheke: Durchgeführte Abgabe\nfür Ramipril erstellen

  Apotheke -> Patient: Ramipril aushändigen

  Apotheke -> Apotheke: Durchgeführte Abgabe\nDexpanthenol-Salbe in\nVorbereitung

  Apotheke -> eMed_FA: Durchgeführte Abgaben\nspeichern

  deactivate Apotheke
  '  deactivate Patient

end

group GROUP_APO 1.3.2026 · Abgabe in der Apotheke (Besorgerprozess abschließen)

  '  activate Patient COLOR_PATIENT

  Patient -> Apotheke: Dexpanthenol-Salbe abholen

  activate Apotheke COLOR_APO
  Apotheke -> eMed_FA: e-Medikation abrufen

  activate eMed_FA COLOR_EMED_FA
  eMed_FA -> Apotheke: AktuellerMedikationsplan\n+ Geplante und Durchgeführte\nAbgaben
  deactivate eMed_FA

  Apotheke -> Patient: Dexpanthenol-Salbe aushändigen


  Apotheke -> eMed_FA: Durchgeführte Abgabe speichern\n(Besorgerprozess abschließen)

  deactivate Apotheke
  '  deactivate Patient
end

group GROUP_PAT 2.3.2026 · Patient ruft Medikationsplan ab

  '  activate Patient COLOR_PATIENT

  Patient -> eMed_FA: Medikationsplan anzeigen

  activate eMed_FA COLOR_EMED_FA

  eMed_FA -> Patient: Aktueller Medikationsplan

  deactivate eMed_FA
  '  deactivate Patient
end


group GROUP_ARZT 3.3.2026 · Präoperativer Hausarzttermin

  '  activate Patient COLOR_PATIENT

  Patient -> Arzt_1: Präoperativer Kontrolltermin

  activate Arzt_1 COLOR_GDA_1

  Arzt_1 -> eMed_FA: e-Medikation abrufen

  activate eMed_FA COLOR_EMED_FA
  eMed_FA -> Arzt_1: Aktueller Medikationsplan
  deactivate eMed_FA

  Arzt_1 -> Arzt_1: Ramipril vorübergehend\npausieren

  Arzt_1 -> eMed_FA: Medikationsplan speichern

  ' activate eMed_FA COLOR_EMED_FA
  ' eMed_FA -> Arzt_1: Medikationsplan gespeichert
  ' deactivate eMed_FA

  deactivate Arzt_1
  '  deactivate Patient
end

group GROUP_KH 5.3.2026 · Geplante Leistenbruchoperation

  '  activate Patient COLOR_PATIENT

  Patient -> Arzt_2: Geplante Operation

  activate Arzt_2 COLOR_GDA_2

  Arzt_2 -> eMed_FA: Medikationsplan abrufen

  activate eMed_FA COLOR_EMED_FA
  eMed_FA -> Arzt_2: Aktueller Medikationsplan
  deactivate eMed_FA

  Arzt_2 -> eMed_FA: neuer Planeintrag Metamizol-\nTropfen erstellen und speichern

  Arzt_2 -> eMed_FA: neue Geplante Abgabe Metamizol-\nTropfen erstellen und speichern
  deactivate Arzt_2
  '  deactivate Patient
end

group GROUP_APO 7.3.2026 · Teilabgabe in der Apotheke

  '  activate Patient COLOR_PATIENT

  Patient -> Apotheke: Metamizol-Tropfen abholen

  activate Apotheke COLOR_APO

  Apotheke -> eMed_FA: e-Medikation abrufen

  activate eMed_FA COLOR_EMED_FA
  eMed_FA -> Apotheke: Medikationsplan\n+ Geplante Abgabe
  deactivate eMed_FA

  Apotheke -> eMed_FA: Durchgeführte Abgabe\nMetamizol als Teilabgabe\nerstellen

  ' activate eMed_FA COLOR_EMED_FA
  ' eMed_FA -> Apotheke: Abgabe gespeichert
  ' deactivate eMed_FA

  Apotheke -> Patient: Metamizol-Tropfen\n(1 Fläschchen) aushändigen

  deactivate Apotheke
  '  deactivate Patient
end

group GROUP_APO 9.3.2026 · Teilabgabe in der Apotheke abschließen

  '  activate Patient COLOR_PATIENT

  Patient -> Apotheke: Metamizol-Tropfen\nabholen

  activate Apotheke COLOR_APO
  Apotheke -> eMed_FA: e-Medikation abrufen

  activate eMed_FA COLOR_EMED_FA
  eMed_FA -> Apotheke: Aktueller Medikationsplan +\nGeplante und Durchgeführte Abgaben
  deactivate eMed_FA

  Apotheke -> eMed_FA: Durchgeführte Abgabe\nspeichern (Teilabgabe\nabschließen)

  Apotheke -> Patient: Metamizol-Tropfen\naushändigen

  deactivate Apotheke
  '  deactivate Patient
end

group GROUP_ARZT 12.3.2026 · Nachkontrolle bei der Urlaubsvertretung von Dr. Hausärztin 

  '  activate Patient COLOR_PATIENT

  Patient -> Arzt_3: Nachkontrolle

  activate Arzt_3 COLOR_GDA_3

  Arzt_3 -> eMed_FA: e-Medikation abrufen

  activate eMed_FA COLOR_EMED_FA
  eMed_FA -> Arzt_3: Aktueller Medikationsplan,\nGeplante und Durchgeführte\nAbgaben
  deactivate eMed_FA

  Arzt_3 -> Arzt_3: Planeintrag Ramipril\nbearbeiten: Pausierung beenden

  Arzt_3 -> Arzt_3: Planeintrag Metamizol\nbearbeiten: Dosierung anpassen 

  Arzt_3 -> eMed_FA: Neuen Medikationsplan\nspeichern

  ' activate eMed_FA COLOR_EMED_FA
  ' eMed_FA -> Arzt_3: Medikationsplan gespeichert
  ' deactivate eMed_FA

  deactivate Arzt_3
  '  deactivate Patient
end

group GROUP_ARZT 20.3.2026 · Kontrolltermin bei Dr. Hausärztin 

  '  activate Patient COLOR_PATIENT

  Patient -> Arzt_1: Kontrolltermin

  activate Arzt_1 COLOR_GDA_1

  Arzt_1 -> eMed_FA: e-Medikation abrufen

  activate eMed_FA COLOR_EMED_FA
  eMed_FA -> Arzt_1: Aktueller Medikationsplan,\nGeplante und Durchgeführte\nAbgaben
  deactivate eMed_FA

  Arzt_1 -> Arzt_1: Planeintrag Metamizol\nbeenden
  Arzt_1 -> Arzt_1: Planeintrag Dexpanthenol-\nSalbe beenden

  Arzt_1 -> eMed_FA: Medikationsplan speichern

  ' activate eMed_FA COLOR_EMED_FA
  ' eMed_FA -> Arzt_1: Medikationsplan gespeichert
  ' deactivate eMed_FA

  deactivate Arzt_1
  deactivate Patient
end

@enduml