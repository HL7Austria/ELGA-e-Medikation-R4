@startuml

title Patient Journey – e-Medikation
'!option handwritten true

skinparam borderColor #000000
skinparam backgroundColor #f5f5f5
skinparam shadowing false
skinparam roundCorner 10
skinparam defaultFontName "Arial"
skinparam defaultFontSize 14
skinparam defaultFontColor #000000

skinparam HyperlinkColor #0000EE
skinparam HyperlinkUnderline false

skinparam BoxPadding 20
skinparam BoxBorderColor #555555

skinparam note {
  BackgroundColor #e0e5f0-#d1d9e6
  BorderColor #8b95a5
  BorderThickness 1
  RoundCorner 0
  Padding 6
  FontColor #111827
  Shadowing false
}

skinparam sequence {
  ParticipantBorderColor #555555
  ParticipantBackgroundColor #ffffff
  ParticipantFontColor #000000
  ParticipantFontSize 14
  ParticipantPadding 20
  ArrowColor #111827
  ArrowThickness 1
  ArrowFontColor #000000
  ArrowFontSize 13
  GroupBorderColor #111827
  GroupBackgroundColor #eef2ff
  GroupBorderThickness 2
}

!define COLOR_GDA_1    #15608280
!define COLOR_GDA_2    #96607D80
!define COLOR_GDA_3    #beaf3c80
!define COLOR_PATIENT  #196B2480
!define COLOR_APO      #0F9ED590
!define COLOR_EMED_FA  #e97232bd
!define COLOR_OK       #0F9ED525
!define COLOR_ERROR    #E9713235

' !define COLOR_GDA_1_BOX    #15608280
' !define COLOR_GDA_2_BOX    #96607D80
' !define COLOR_PATIENT_BOX  #196B2480
' !define COLOR_APO_BOX      #0F9ED590
' !define COLOR_EMED_FA_BOX  #e97232bd

actor Patient as "Max Mustermann" COLOR_PATIENT
actor Arzt_1 as "Dr. Hausärztin" COLOR_GDA_1
actor Arzt_2 as "Dr. Krankenhaus" COLOR_GDA_2
actor Arzt_3 as "Dr. Urlaubsvertretung" COLOR_GDA_3
actor Apotheke as "Amadeus Apotheke" COLOR_APO
participant eMed_FA as "e-Medikation" COLOR_EMED_FA

!define GROUP_ARZT          #96607D30
!define GROUP_APO           #0F9ED530
!define GROUP_KH           #beaf3c30
!define GROUP_PAT           #196B2430


' box "\n Patient " COLOR_PATIENT_BOX
' actor Patient as "Max Mustermann" COLOR_PATIENT
' end box

' box "\n Ärztin " COLOR_GDA_1_BOX
' actor Arzt_1 as "Dr. Hausärztin" COLOR_GDA_1
' end box

' box "\n Krankenhaus " COLOR_GDA_2_BOX
' actor Arzt_2 as "Dr. Krankenhaus" COLOR_GDA_2
' end box

' box "\n Apotheke " COLOR_APO_BOX
' actor Apotheke as "Amadeus Apotheke" COLOR_APO
' end box

' box "\n       e-Med Fachanwendung       " COLOR_EMED_FA
' participant eMed_FA as "e-Medikation" COLOR_EMED_FA
' end box


autonumber

group GROUP_ARZT 27.2.2026 · Arztbesuch

  activate Patient COLOR_PATIENT
  Patient -> Arzt_1: Arztbesuch

  note over Patient
  Herr Mustermann kommt wegen
  Kopfschmerzen und Schwindel-
  gefühl zu seiner Hausärztin.

  Außerdem hat er einen leichten
  Hautausschlag bemerkt.
  bemerkt.
  end note

  activate Arzt_1 COLOR_GDA_1

  note over Arzt_1
  Dr. Hausärztin stellt eine
  leichte arterielle Hypertonie 
  fest und ruft die e-Medikation 
  (aktueller Medikationsplan,
  Geplante und Durchgeführte 
  Abgaben) ab, um einen Überblick
  über seine aktuelle Medikation 
  zu erhalten.
  end note

  == Medikationsplan erstmals abrufen ==

  Arzt_1 -> eMed_FA: e-Medikation abrufen

  activate eMed_FA COLOR_EMED_FA

  note over eMed_FA
  Da für Herrn Mustermann noch 
  nie ein Medikationsplan 
  abgerufen wurde, erstellt die
  Fachanwendung automatisch einen
  leeren Medikationsplan 
  (*EmptyReason = notstarted*).
  end note

  eMed_FA --> Arzt_1: Leerer Medikationsplan

  deactivate eMed_FA

  == Medikationsplaneinträge hinzufügen ==

  note over Arzt_1
  Dr. Hausärztin erstellt 2
  Medikationsplaneinträge und 
  klärt den Patienten über die 
  Anwendung auf:
  - gegen arterielle Hypertonie:
  Ramipril 5 mg, 
  1 x täglich morgens, 
  als Dauermedikation
  - gegen Hautausschlag:
  Dexpanthenol-5-%-Salbe,
  2 × täglich für 1 Woche,
  dünn auftragen
  end note

  Arzt_1 -> eMed_FA: neuen Medikationsplan speichern

  activate eMed_FA COLOR_EMED_FA

  note over eMed_FA
  Im neu erstellten Medikationsplan
  sind die neuen Planeinträge sowie
  das Datum der Bearbeitung und die 
  verantwortliche Ärztin (Dr. 
  Dr. Hausärztin) ersichtlich.
  end note


  note over Arzt_1
  Dr. Hausärztin erstellt 
  für beide Medikamente eine 
  Geplante Abgabe (Rezeptierung), 
  sodass Herr Mustermann die 
  Medikamente in der Apotheke 
  abholen kann.
  end note

  Arzt_1 -> eMed_FA: Geplante Abgaben erstellen

  deactivate eMed_FA
  deactivate Arzt_1
  deactivate Patient

end

group GROUP_APO 28.2.2026 · Abgabe in der Apotheke (Besorgerprozess)

  activate Patient COLOR_PATIENT
  note over Patient
  Herr Mustermann möchte in 
  der Apotheke die Medikamente
  abholen und steckt seine e-card. 
  end note

  Patient -> Apotheke: Medikamente abholen

  activate Apotheke COLOR_APO

  note over Apotheke
  Die Apothekerin ruft Geplante, 
  Durchgeführte Abgaben und den 
  Medikationsplan ab, und prüft
  die Medikation hinsichtlich 
  Wechselwirkungen.
  end note

  Apotheke -> eMed_FA: e-Medikation abrufen

  activate eMed_FA COLOR_EMED_FA
  eMed_FA --> Apotheke: Aktueller Medikationsplan + Geplante Abgaben
  deactivate eMed_FA

  note over Apotheke
  Sie händigt das Medikament 
  Ramipril aus, erklärt die 
  Einnahme und erstellt eine 
  Durchgeführte Abgabe.
  end note


  Apotheke -> Apotheke: Durchgeführte Abgabe\nRamipril erstellen

  Apotheke -> Patient: Ramipril aushändigen

  note over Apotheke
  Die Dexpanthenol-Salbe 
  muss noch hergestellt werden. 
  Die Apothekerin erstellt
  eine Durchgeführte Abgabe 
  und kennzeichnet sie 
  entsprechend Besorgerprozess.
  end note

  Apotheke -> Apotheke: Durchgeführte Abgabe\nDexpanthenol-Salbe in Vorbereitung

  Apotheke -> eMed_FA: Durchgeführte Abgaben speichern

  deactivate Apotheke
  deactivate Patient

end

group GROUP_APO 1.3.2026 · Abgabe in der Apotheke (Besorgerprozess abschließen)

  activate Patient COLOR_PATIENT

  note over Patient
  Herr Mustermann möchte in
  der Apotheke die Dexpanthenol-
  Salbe abholen und steckt seine 
  e-card. 
  end note  

  Patient -> Apotheke: Dexpanthenol-Salbe abholen

  activate Apotheke COLOR_APO
  Apotheke -> eMed_FA: e-Medikation abrufen

  activate eMed_FA COLOR_EMED_FA
  eMed_FA --> Apotheke: AktuellerMedikationsplan + Geplante und Durchgeführte Abgaben
  deactivate eMed_FA

  note over Apotheke
  Die Apothekerin ruft die e-Medikation
  erneut ab und schließt den 
  Besorgerprozess ab, indem sie
  eine weitere Durchgeführte Abgabe
  erstellt und übergibt dem 
  Patienten die Dexpanthenol-Salbe.
  end note

  Apotheke -> Patient: Dexpanthenol-Salbe aushändigen


  Apotheke -> eMed_FA: Durchgeführte Abgabe speichern\n(Besorgerprozess abschließen)

  deactivate Apotheke
  deactivate Patient
end

group GROUP_PAT 2.3.2026 · Patient ruft Medikationsplan ab

  activate Patient COLOR_PATIENT

  note over Patient
  Herr Mustermann erinnert sich 
  nicht, welches Medikament er
  wie einnehmen soll und ruft 
  im Zugangsportal seinen 
  Medikationsplan auf.   
  end note

  Patient -> eMed_FA: Medikationsplan anzeigen

  activate eMed_FA COLOR_EMED_FA

  eMed_FA --> Patient: Aktueller Medikationsplan

  deactivate eMed_FA
  deactivate Patient
end


group GROUP_ARZT 3.3.2026 · Präoperativer Hausarzttermin

  activate Patient COLOR_PATIENT

  note over Patient
  Bei Herrn Mustermann steht eine
  geplante Leistenbruchoperation an.
  Vor der Operation bespricht er
  die bestehende Medikation mit
  seiner Hausärztin.
  end note

  Patient -> Arzt_1: Präoperativer Kontrolltermin

  activate Arzt_1 COLOR_GDA_1

  Arzt_1 -> eMed_FA: e-Medikation abrufen

  activate eMed_FA COLOR_EMED_FA
  eMed_FA --> Arzt_1: Aktueller Medikationsplan
  deactivate eMed_FA

  note over Arzt_1
  Die geplante Leistenbruchoperation
  ist für den 5.3.2026 vorgesehen.

  Dr. Hausärztin weist Herrn Mustermann
  an, Ramipril vor der Operation
  vorübergehend abzusetzen.
  end note

  Arzt_1 -> Arzt_1: Ramipril vorübergehend pausieren

  Arzt_1 -> eMed_FA: Medikationsplan speichern

  ' activate eMed_FA COLOR_EMED_FA
  ' eMed_FA --> Arzt_1: Medikationsplan gespeichert
  ' deactivate eMed_FA

  deactivate Arzt_1
  deactivate Patient
end

group GROUP_KH 5.3.2026 · Geplante Leistenbruchoperation

  activate Patient COLOR_PATIENT

  note over Patient
  Herr Mustermann kommt zur
  geplanten Leistenbruchoperation.

  Ramipril wurde entsprechend
  der ärztlichen Anweisung
  vorübergehend pausiert.
  end note

  Patient -> Arzt_2: Geplante Operation

  activate Arzt_2 COLOR_GDA_2

  Arzt_2 -> eMed_FA: Medikationsplan abrufen

  activate eMed_FA COLOR_EMED_FA
  eMed_FA --> Arzt_2: Aktueller Medikationsplan
  deactivate eMed_FA

  note over Arzt_2
  Die Leistenbruchoperation
  verläuft komplikationslos.
  Nach der Operation erhält 
  Herr Mustermann Metamizol-
  Tropfen gegen die postoperativen
  Schmerzen.
  Metamizol-Tropfen, 2 Fläschchen:
  3 × täglich 30 Tropfen
  für wenige Tage (nach Bedarf)
  end note

  Arzt_2 -> eMed_FA: neuer Planeintrag Metamizol-Tropfen erstellen und speichern

  Arzt_2 -> eMed_FA: neue Geplante Abgabe Metamizol-Tropfen erstellen und speichern
  deactivate Arzt_2
  deactivate Patient
end

group GROUP_APO 7.3.2026 · Teilabgabe in der Apotheke

  activate Patient COLOR_PATIENT

  note over Patient
  Herr Mustermann möchte in 
  der Apotheke die Metamizol-Tropfen
  abholen und steckt seine e-card. 
  end note

  Patient -> Apotheke: Metamizol-Tropfen abholen

  activate Apotheke COLOR_APO

  Apotheke -> eMed_FA: e-Medikation abrufen

  activate eMed_FA COLOR_EMED_FA
  eMed_FA --> Apotheke: Medikationsplan\n+ Geplante Abgabe
  deactivate eMed_FA

  note over Patient
  Es ist nur noch ein Fläschchen 
  Metamizol verfügbar. Die 
  Apothekerin händigt das Fläschchen 
  aus und erstellt eine Durchgeführte 
  Abgabe als Teilabgabe.
  Die Patienten wird angewiesen, 
  das zweite Fläschchen in der 
  Apotheke abzuholen, sobald es 
  verfügbar ist.
  end note

  Apotheke -> eMed_FA: Durchgeführte Abgabe\nMetamizol als Teilabgabe erstellen

  ' activate eMed_FA COLOR_EMED_FA
  ' eMed_FA --> Apotheke: Abgabe gespeichert
  ' deactivate eMed_FA

  Apotheke -> Patient: Metamizol-Tropfen (1 Fläschchen) aushändigen

  deactivate Apotheke
  deactivate Patient
end

group GROUP_APO 9.3.2026 · Teilabgabe in der Apotheke abschließen

  activate Patient COLOR_PATIENT

  note over Patient
  Herr Mustermann wurde von der 
  Apotheke informiert, dass
  die Metamizol-Tropfen nun 
  verfügbar sind. Er steckt 
  in der Apotheke seine e-card. 
  end note  

  Patient -> Apotheke: Metamizol-Tropfen abholen

  activate Apotheke COLOR_APO
  Apotheke -> eMed_FA: e-Medikation abrufen

  activate eMed_FA COLOR_EMED_FA
  eMed_FA --> Apotheke: AktuellerMedikationsplan + Geplante und Durchgeführte Abgaben
  deactivate eMed_FA

  note over Apotheke
  Die Apothekerin ruft die e-Medikation
  erneut ab und schließt dann die 
  Teilabgabe ab, indem sie
  eine weitere Durchgeführte Abgabe
  erstellt und übergibt dem 
  Patienten die Metamizol-Tropfen.
  end note

  Apotheke -> eMed_FA: Durchgeführte Abgabe speichern\n(Teilabgabe abschließen)

  Apotheke -> Patient: Metamizol-Tropfen aushändigen

  deactivate Apotheke
  deactivate Patient
end

group GROUP_ARZT 12.3.2026 · Nachkontrolle bei der Urlaubsvertretung von Dr. Hausärztin 

  activate Patient COLOR_PATIENT

  note over Patient
  Herr Mustermann hat die 
  Medikamente in der Apotheke 
  abgeholt und die Schmerzen sind 
  deutlich zurückgegangen.

  Eine Woche nach der Operation 
  kommt er zur Nachkontrolle 
  zur Urlaubsvertretung von 
  Dr. Hausärztin.
  end note

  Patient -> Arzt_3: Nachkontrolle

  activate Arzt_3 COLOR_GDA_3

  Arzt_3 -> eMed_FA: e-Medikation abrufen

  activate eMed_FA COLOR_EMED_FA
  eMed_FA --> Arzt_3: Aktueller Medikationsplan, Geplante und Durchgeführte Abgaben
  deactivate eMed_FA

  note over Arzt_3
  Für die verbleibenden Schmerzen
  wird die Metamizoldosis für einen 
  begrenzten Zeitraum weiterverodnet,
  die Dosis aber reduziert:
  Metamizol-Tropfen:
  2 × täglich 10 Tropfen
  für wenige Tage (nach Bedarf)

  Ramipril kann wieder eingenommen
  werden.
  end note

  Arzt_3 -> Arzt_3: Planeintrag Ramipril bearbeiten: Pausierung beenden

  Arzt_3 -> Arzt_3: Planeintrag nMetamizol bearbeiten: Dosierung anpassen 

  Arzt_3 -> eMed_FA: Neuen Medikationsplan speichern

  note over eMed_FA
  Im neu erstellten Medikationsplan
  sind die neuen Planeinträge sowie
  das Datum der Bearbeitung und die 
  verantwortliche Ärztin (Dr. 
  Urlaubsvertretung) ersichtlich.
  end note

  ' activate eMed_FA COLOR_EMED_FA
  ' eMed_FA --> Arzt_3: Medikationsplan gespeichert
  ' deactivate eMed_FA

  deactivate Arzt_3
  deactivate Patient
end

group GROUP_ARZT 20.3.2026 · Kontrolltermin bei Dr. Hausärztin 

  activate Patient COLOR_PATIENT

  note over Patient
  Herr Mustermann erscheint zur
  Wundkontrolle bei Dr. Hausärztin. 
  end note

  Patient -> Arzt_1: Kontrolltermin

  activate Arzt_1 COLOR_GDA_1

  Arzt_1 -> eMed_FA: e-Medikation abrufen

  activate eMed_FA COLOR_EMED_FA
  eMed_FA --> Arzt_1: Aktueller Medikationsplan, Geplante und Durchgeführte Abgaben
  deactivate eMed_FA

  note over Arzt_1
  Die postoperative Schmerztherapie
  ist nicht mehr erforderlich. Der 
  Planeintrag für Metamizol wird daher beendet.

  Die Behandlung mit der
  Dexpanthenol-Salbe ist ebenfalls
  abgeschlossen. 

  Ramipril wird als
  Dauermedikation fortgeführt.
  end note

  Arzt_1 -> Arzt_1: Planeintrag Metamizol beenden
  Arzt_1 -> Arzt_1: Planeintrag Dexpanthenol-Salbe beenden

  Arzt_1 -> eMed_FA: Medikationsplan speichern

  note over eMed_FA
  Im neu erstellten Medikationsplan
  sind die neuen Planeinträge sowie
  das Datum der Bearbeitung und die 
  verantwortliche Ärztin (Dr. 
  Hausärztin) ersichtlich.
  end note

  ' activate eMed_FA COLOR_EMED_FA
  ' eMed_FA --> Arzt_1: Medikationsplan gespeichert
  ' deactivate eMed_FA

  deactivate Arzt_1
  deactivate Patient
end

@enduml