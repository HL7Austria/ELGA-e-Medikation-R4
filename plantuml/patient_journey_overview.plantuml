@startuml


sprite document <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-medical" viewBox="0 0 16 16">
  <path d="M7.5 5.5a.5.5 0 0 0-1 0v.634l-.549-.317a.5.5 0 1 0-.5.866L6 7l-.549.317a.5.5 0 1 0 .5.866l.549-.317V8.5a.5.5 0 1 0 1 0v-.634l.549.317a.5.5 0 1 0 .5-.866L8 7l.549-.317a.5.5 0 1 0-.5-.866l-.549.317zm-2 4.5a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1zm0 2a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1z"/>
  <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z"/>
</svg>

sprite face <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-emoji-expressionless" viewBox="0 0 16 16">
  <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
  <path d="M4 10.5a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5m5 0a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5"/>
</svg>

sprite capsule <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-capsule" viewBox="0 0 16 16">
  <path d="M1.828 8.9 8.9 1.827a4 4 0 1 1 5.657 5.657l-7.07 7.071A4 4 0 1 1 1.827 8.9Zm9.128.771 2.893-2.893a3 3 0 1 0-4.243-4.242L6.713 5.429z"/>
</svg>

title Patient Journey – e-Medikation
'!option handwritten true

skinparam borderColor #000000
skinparam backgroundColor #f5f5f5
skinparam shadowing false
skinparam roundCorner 10
skinparam defaultFontName "Arial"
skinparam defaultFontSize 14
skinparam defaultFontColor #000000

skinparam HyperlinkColor #0000EE
skinparam HyperlinkUnderline false

skinparam BoxPadding 20
skinparam BoxBorderColor #555555

skinparam note {
  BackgroundColor #e0e5f0-#d1d9e6
  BorderColor #8b95a5
  BorderThickness 1
  RoundCorner 0
  Padding 6
  FontColor #111827
  Shadowing false
}

skinparam sequence {
  ParticipantBorderColor #555555
  ParticipantBackgroundColor #ffffff
  ParticipantFontColor #000000
  ParticipantFontSize 14
  ParticipantPadding 20
  ArrowColor #111827
  ArrowThickness 1
  ArrowFontColor #000000
  ArrowFontSize 13
  GroupBorderColor #111827
  GroupBackgroundColor #eef2ff
  GroupBorderThickness 2
}

!define COLOR_GDA_1    #15608280
!define COLOR_GDA_2    #96607D80
!define COLOR_GDA_3    #beaf3c80
!define COLOR_PATIENT  #196B2480
!define COLOR_APO      #0F9ED590
!define COLOR_EMED_FA  #e97232bd
!define COLOR_OK       #0F9ED525
!define COLOR_ERROR    #E9713235

' !define COLOR_GDA_1_BOX    #15608280
' !define COLOR_GDA_2_BOX    #96607D80
' !define COLOR_PATIENT_BOX  #196B2480
' !define COLOR_APO_BOX      #0F9ED590
' !define COLOR_EMED_FA_BOX  #e97232bd

actor Patient as "Max Mustermann" COLOR_PATIENT
actor Arzt_1 as "Dr. Hausärztin" COLOR_GDA_1
actor Arzt_2 as "Dr. Krankenhaus" COLOR_GDA_2
actor Arzt_3 as "Dr. Urlaubsvertretung" COLOR_GDA_3
actor Apotheke as "Amadeus Apotheke" COLOR_APO
participant eMed_FA as "e-Medikation" COLOR_EMED_FA

!define GROUP_ARZT          #96607D30
!define GROUP_APO           #0F9ED530
!define GROUP_KH           #beaf3c30
!define GROUP_PAT           #196B2430


autonumber
group GROUP_ARZT 27.2.2026 · Arztbesuch

  ' activate Patient COLOR_PATIENT
  Patient -> Arzt_1: Arztbesuch  <$face>
  note over Patient
  Herr Mustermann kommt 
  mit Symptomen zur Ärztin 
  und erhält Ramipril +
  Dexpanthenol-Salbe verordnet.
  end note
  Arzt_1 -> eMed_FA: e-Medikation abrufen 
  eMed_FA -> Arzt_1: <$document> leerer Medikationsplan
  Arzt_1 -> eMed_FA: Neuen Medikationsplan mit\nRamipril + Dexpanthenol-Salbe\nspeichern
  Arzt_1 -> eMed_FA: Geplante Abgaben erstellen\n(Ramipril + Dexpanthenol-Salbe) 
  Arzt_1 -> Patient: Rezept aushändigen (optional)

end


group GROUP_APO 28.2.2026 · Abgabe in der Apotheke (Besorgerprozess)

  Patient -> Apotheke: Medikamente abholen
  note over Patient
  Herr Mustermann erhält 
  in der Apotheke Ramipril,
  die Dexpanthenol-Salbe 
  muss noch zubereitet werden.
  end note
  Apotheke -> eMed_FA: e-Medikation abrufen
  eMed_FA -> Apotheke: <$document> Medikationsplan, Geplante Abgaben für\nRamipril + Dexpanthenol-Salbe
  Apotheke -> Patient: Ramipril aushändigen <$capsule>
  Apotheke -> Patient: Abholzettel für Dexpanthenol-Salbe aushändigen 
  Apotheke -> eMed_FA: Durchgeführte Abgaben erstellen\nRamipril: Vollständige Abgabe\nDexpanthenol-Salbe (Besorgerprozess)
end

group GROUP_APO 1.3.2026 · Abgabe in der Apotheke (Besorgerprozess abschließen)
  Patient -> Apotheke: Dexpanthenol-Salbe abholen
  note over Patient
  Herr Mustermann erhält die 
  Dexpanthenol-Salbe in der 
  Apotheke.
  end note
  Apotheke -> eMed_FA: e-Medikation abrufen
  eMed_FA -> Apotheke: <$document> Medikationsplan + offene Geplante Abgabe:\nDexpanthenol-Salbe
  Apotheke -> Patient: Dexpanthenol-Salbe aushändigen <$capsule>
  Apotheke -> eMed_FA: Durchgeführte Abgabe\nfür Dexpanthenol-Salbe erstellen\n(Besorgerprozess abschließen)

end

group GROUP_PAT 7.3.2026 · Patient ruft Medikationsplan ab

  Patient -> eMed_FA: e-Medikation abrufen
  eMed_FA -> Patient: <$document> Medikationsplan + abgeschlossene Geplante Abgaben +\nDurchgeführte Abgaben für Ramipril und Dexpanthenol-Salbe
  note over Patient
  Herr Mustermann ruft seine 
  e-Medikation ab.
  end note
end


group GROUP_ARZT 3.3.2026 · Präoperativer Hausarzttermin

  Patient -> Arzt_1: Präoperativer Kontrolltermin
  Arzt_1 -> eMed_FA: e-Medikation abrufen
  eMed_FA -> Arzt_1: <$document> Medikationsplan
  Arzt_1 -> eMed_FA: Medikationsplan aktualisieren:\nRamipril vorübergehend pausieren
  note over Patient
  Für eine geplante Operation 
  wird Ramipril pausiert. 
  end note

end

group GROUP_ARZT 17.3.2026 bis 21.3.2026 · Stationärer Krankenhausaufenthalt

  Patient -> Arzt_1: Krankenhausbesuch 

  Arzt_1 -> eMed_FA: aktuellen Medikationsplan abrufen:\n$plan-read 

  eMed_FA -> Arzt_1: Medikationsplan\n(pausiertes Ramipril + Dexpanthenol-Salbe)


  Arzt_1 -> Arzt_1: Medikationsplan bearbeiten +\nPlaneintrag Ramipril ändern +\nneuen Planeintrag mit Wirkstoff Metamizol erstellen
  Arzt_1 -> eMed_FA: neuen Medikationsplan speichern: $plan-write

  eMed_FA -> Arzt_1: Medikationsplan 

  note over Patient
  Abruf Geplante Abgaben
  und Durchgeführte Abgaben 
  siehe Journey-04
  end note

end





@enduml